# Backend environment example
# Copy this file to .env and fill in real values.

# API key protection
API_KEY=your-api-key
API_KEY_NAME=your-api-key-header-name

# PostgreSQL
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=your-db-host
DB_PORT=your-db-port
DB_NAME=your-db-name

# Optional: skip DB init in special scripts
SKIP_DB_INIT=your-skip-db-init-flag

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=your-azure-openai-api-version
AZURE_OPENAI_DEPLOYMENT_NAME=your-azure-openai-deployment-name

# Azure Storage
STORAGE_ACCOUNT_CONNECTION_STRING=your-storage-account-connection-string
STORAGE_ACCOUNT_KEY=your-storage-account-key
RESUME_CONTAINER_NAME=your-resume-container-name
JD_CONTAINER_NAME=your-jd-container-name

# Email and HR notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=your-smtp-port
GMAIL_USERNAME=your-smtp-username
GMAIL_PASSWORD=your-smtp-password
HR_EMAIL=your-hr-email
HR_EMAILS=your-hr-email-list
